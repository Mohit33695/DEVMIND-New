# DevMind AI Backend - Example Environment Configuration
# Copy this file to .env for local environment overrides.
# NOTE: Real API keys will be added in a future milestone.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding Provider Configuration
# Supported: mock, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock
EMBEDDING_DIMENSION=384
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=100

# LLM Provider Configuration
# Supported in Milestone AA.1: mock
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# Secrets / API Keys (Optional backend-only configuration - NOT used in Milestone AA.1)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
